# Copy this file to secrets.env and fill in the values.
#
#   cp .env.example secrets.env
#   chmod 600 secrets.env
#
# secrets.env is gitignored and must never be committed.

# ─── LLM providers ───────────────────────────────────────────
# The gateway tries these in order and drops to the next when one
# rate-limits or errors. At least one is required; more means more
# headroom on free tiers.
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=

# ─── Telegram ────────────────────────────────────────────────
# Bot token from @BotFather, and the chat the notifier posts to.
TELEGRAM_NOTIFIER_TOKEN=
TELEGRAM_CHAT_ID=

# ─── Data sources ────────────────────────────────────────────
# Private iCalendar feed URL for course deadlines. The token is
# embedded in the URL, so treat the whole string as a secret.
ONQ_ICS_URL=

# ─── Internal service URLs ───────────────────────────────────
# Where each component can reach the others. Defaults assume
# everything runs on one host.
WORKERS_API=http://127.0.0.1:8002
LLM_GATEWAY_URL=http://127.0.0.1:8003

# Reachable only over the private network (Tailscale). Leave blank
# to disable the PC relay used for scrapers that datacenter IPs
# can't reach.
PC_API=
PC_QUEENS_URL=

# ─── Paths ───────────────────────────────────────────────────
OBSIDIAN_VAULT_PATH=/home/ubuntu/personal-agent/vault
QUEUE_DB=data/queue.db
REMINDERS_DB=data/reminders.db
SENT_DB=data/sent.db
