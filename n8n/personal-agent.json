        "parameters": {
          "toolDescription": "Fresh LIVE search of company career sites. Params: role_keywords (comma-separated, default software,backend,developer,engineer), require_intern (true/false, default true -- false for non-intern roles), locations (comma-separated, default toronto,kingston,remote), timeframe (the term the job runs in). LEAVE timeframe OUT unless the user themselves named a term in this conversation -- never guess or copy an example, because a wrong timeframe silently hides real jobs. Returns total_matching (the number to report), new_count (0 is normal), and matches.",
          "url": "http://localhost:8002/run/jobs",
          "method": "GET",
          "sendQuery": true,
          "specifyQuery": "keypair",
          "parametersQuery": {
            "values": [
              {
                "name": "role_keywords",
                "valueProvider": "modelOptional"
              },
