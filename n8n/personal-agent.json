      {
        "parameters": {
          "jsCode": "// Telegram HTML parse_mode is strict -- one stray & or < and the whole message\n// is rejected and the user gets nothing. So escape everything the agent wrote.\n// The agent emits an optional \"TITLE: ...\" first line; that becomes the heading.\nconst esc = (s) => String(s)\n  .replace(/&/g, '&amp;')\n  .replace(/</g, '&lt;')\n  .replace(/>/g, '&gt;');\n\nconst out = [];\nfor (const item of $input.all()) {\n  const raw = String(item.json.output ?? '').trim();\n  const m = raw.match(/^TITLE:\\s*([^\\n]+)\\n?([\\s\\S]*)$/);\n  let formatted;\n  if (m) {\n    const body = esc((m[2] || '').trim());\n    formatted = '<b>' + esc(m[1].trim()) + '</b>' + (body ? '\\n\\n' + body : '');\n  } else {\n    // agent skipped the title -- degrade to plain escaped text rather than fail\n    formatted = esc(raw);\n  }\n  out.push({ json: { formatted, output: raw } });\n}\nreturn out;\n"
        },
